<%- layout('layout/boilerplate') -%>

<div class="container mt-4">
    <h1 class="mb-4">Create a New Listing</h1>

    <form method="POST" action="/listings" id="newListingForm">

        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input 
                type="text" 
                class="form-control" 
                id="title" 
                name="title" 
                placeholder="Enter title" 
                required
            >
        </div>

        <div class="mb-3">
            <label for="price" class="form-label">Price</label>
            <input 
                type="number" 
                class="form-control" 
                id="price" 
                name="price" 
                placeholder="Enter price" 
                required
            >
        </div>

        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <input 
                type="text" 
                class="form-control" 
                id="description" 
                name="description" 
                placeholder="Enter description" 
                required
            >
        </div>

        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input 
                type="text" 
                class="form-control" 
                id="location" 
                name="location" 
                placeholder="Enter location" 
                required
            >
        </div>

        <div class="mb-3">
            <label for="country" class="form-label">Country</label>
            <input 
                type="text" 
                class="form-control" 
                id="country" 
                name="country" 
                placeholder="Enter country" 
                required
            >
        </div>

        <div class="mb-3">
            <label for="imageUrl" class="form-label">Image URL</label>
            <input 
                type="text" 
                class="form-control" 
                id="imageUrl" 
                name="imageUrl" 
                placeholder="Paste a URL if you prefer"
            >
        </div>

        <div class="mb-4">
            <label for="imageFile" class="form-label">Upload image</label>
            <input 
                type="file" 
                class="form-control" 
                id="imageFile" 
                accept="image/*"
            >
            <small class="form-help">Choose a file or paste an image URL.</small>
        </div>

        <input type="hidden" id="image" name="image" value="">

        <button type="submit" class="btn btn-primary">
            Create Listing
        </button>

    </form>

    <script>
      const imageFileInputNew = document.getElementById('imageFile');
      const imageUrlInputNew = document.getElementById('imageUrl');
      const imageHiddenInputNew = document.getElementById('image');

      imageFileInputNew.addEventListener('change', function () {
        const file = this.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function (event) {
          imageHiddenInputNew.value = event.target.result;
          imageUrlInputNew.value = '';
        };
        reader.readAsDataURL(file);
      });

      imageUrlInputNew.addEventListener('input', function () {
        if (this.value.trim()) {
          imageHiddenInputNew.value = this.value.trim();
        }
      });
    </script>
</div>
